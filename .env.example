# Copie para .env e preencha.

# Porta local do servidor (o Nginx/Caddy faz o HTTPS na frente).
# Tem que ser a MESMA porta do proxy_pass em deploy/nginx-tracking.conf.
PORT=3101

# Endereço em que o servidor escuta. 127.0.0.1 = só a própria VPS (o Nginx
# acessa por aí). Só troque para 0.0.0.0 se não houver proxy na frente.
HOST=127.0.0.1

# Endereço público HTTPS do rastreador (sem barra no fim).
PUBLIC_URL=https://tracking.odingdong.tech

# Login do painel.
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# Chave secreta que protege o postback e a URL da planilha do Google Ads.
# Gere uma com:  node -e "console.log(require('crypto').randomBytes(18).toString('hex'))"
SECRET_KEY=troque-esta-chave

# Nome EXATO da ação de conversão criada no Google Ads.
CONVERSION_NAME=Compra BuyGoods

# Moeda da comissão.
CURRENCY=USD

# Quantos dias de vendas entram na planilha (o Google ignora duplicadas).
EXPORT_DAYS=30

# Fuso usado no painel (datas e filtro "hoje").
DISPLAY_TZ=America/Sao_Paulo

# Arquivo do banco de dados.
DB_PATH=./dados/rastreador.db
