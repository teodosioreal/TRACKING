# Copie para /etc/systemd/system/tracking.service.
[Unit]
Description=Rastreador Google Ads + BuyGoods
After=network.target

[Service]
WorkingDirectory=/opt/tracking
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server.js
Restart=always
RestartSec=3
User=www-data

[Install]
WantedBy=multi-user.target
